APP_ENV=development
DEBUG=true

POSTGRES_USER=azs
POSTGRES_PASSWORD=change-db-password
POSTGRES_DB=azs_bonus

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://azs:change-db-password@postgres:5432/azs_bonus
SYNC_DATABASE_URL=postgresql+psycopg://azs:change-db-password@postgres:5432/azs_bonus

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-me-in-production-very-long-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# SMS
# stub | sms_ru | bytehand | smsc
SMS_PROVIDER=stub
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER=
SMS_PROVIDER_INTERNATIONAL_SENDER=
SMS_PROVIDER_URL=
SMS_PROVIDER_SMS_RU_URL=
SMS_PROVIDER_BYTEHAND_URL=
SMS_PROVIDER_SMSC_URL=
SMS_PROVIDER_FALLBACK=
SMS_CODE_LENGTH=4
MOBILE_AUTH_USE_TEST_CODE=false
MOBILE_AUTH_MAX_CODE_ATTEMPTS=2

# Bonus settings
MAX_REDEMPTION_PERCENT=100
BONUS_EXPIRY_MONTHS=12

# Google Play / TWA
ANDROID_APP_PACKAGE=com.azsbonus.app
ANDROID_SHA256_CERT_FINGERPRINTS=
PUBLIC_APP_URL=https://azsbonus.tj
APP_TIMEZONE=Asia/Dushanbe
